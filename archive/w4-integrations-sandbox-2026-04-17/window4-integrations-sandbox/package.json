{
  "name": "window4-integrations-sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Window 4 LionWheel integration scaffolding. Parallel-safe reference, not canonical runtime.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "cli:lionwheel": "tsx src/lionwheel/cli.ts",
    "cli:shopify": "tsx src/shopify/cli.ts",
    "test": "tsx --test src/lionwheel/__tests__/mapper.spec.ts src/shopify/__tests__/mapper.spec.ts",
    "test:lionwheel": "tsx --test src/lionwheel/__tests__/mapper.spec.ts",
    "test:shopify": "tsx --test src/shopify/__tests__/mapper.spec.ts",
    "replay": "tsx src/lionwheel/__tests__/replay.ts && tsx src/shopify/__tests__/replay.ts",
    "replay:lionwheel": "tsx src/lionwheel/__tests__/replay.ts",
    "replay:shopify": "tsx src/shopify/__tests__/replay.ts"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
